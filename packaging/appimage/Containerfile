# Build environment for the OpenBlade-Synapse AppImage.
# Ubuntu 22.04 (glibc 2.35) as the base, so the AppImage also runs on older distributions
# (Linux Mint 21/22, Ubuntu 22.04+, Debian 12+); Qt comes from the official Qt binaries (aqtinstall)
# and is bundled into the AppImage.
FROM docker.io/library/ubuntu:22.04
ARG QT_VERSION=6.11.2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl file git pkg-config patchelf python3 python3-pip \
      libgl1-mesa-dev libegl1-mesa-dev libxkbcommon-dev libxkbcommon-x11-0 libfontconfig1 libfreetype6 \
      libglib2.0-0 libdbus-1-3 libx11-6 libx11-xcb1 libxext6 libxrender1 libsm6 libice6 \
      libxcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
      libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libxcb-sync1 libxcb-xfixes0 libxcb-shm0 libxcb-util1 \
      libwayland-client0 libwayland-cursor0 libwayland-egl1 \
    && rm -rf /var/lib/apt/lists/*
# Qt (official binaries)
RUN pip3 install --no-cache-dir aqtinstall \
    && aqt install-qt linux desktop ${QT_VERSION} linux_gcc_64 -O /opt/qt \
    && ln -s /opt/qt/${QT_VERSION}/gcc_64 /opt/qt/current
# Rust
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --no-modify-path
# AppImage tools (run without FUSE inside the container)
ENV APPIMAGE_EXTRACT_AND_RUN=1
RUN mkdir -p /opt/tools && cd /opt/tools \
    && curl -fsSLO https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
    && curl -fsSLO https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/continuous/linuxdeploy-plugin-qt-x86_64.AppImage \
    && curl -fsSLO https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
    && curl -fsSLO https://github.com/AppImage/type2-runtime/releases/download/continuous/runtime-x86_64 \
    && chmod +x /opt/tools/*
ENV PATH=/opt/tools:$PATH
